<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>E-invoicing mandates — {{.Release.Release}}</title>
<style>
  :root { color-scheme: light dark; --fg:#16181d; --bg:#fff; --muted:#5b6270; --line:#e2e5ea; --accent:#0b5fff; }
  @media (prefers-color-scheme: dark) {
    :root { --fg:#e6e8ec; --bg:#14161a; --muted:#9aa2b1; --line:#2a2e36; --accent:#7aa2ff; }
  }
  * { box-sizing: border-box; }
  body { margin:0; padding:2rem 1.25rem 4rem; font:15px/1.5 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,sans-serif;
         color:var(--fg); background:var(--bg); }
  main { max-width: 1200px; margin: 0 auto; }
  h1 { font-size:1.6rem; margin:0 0 .25rem; }
  .meta { color:var(--muted); font-size:.85rem; margin-bottom:1.5rem; }
  .controls { display:flex; gap:.75rem; flex-wrap:wrap; margin-bottom:1rem; }
  input, select { padding:.45rem .6rem; border:1px solid var(--line); border-radius:6px; background:var(--bg); color:var(--fg); font-size:.9rem; }
  .wrap { overflow-x:auto; border:1px solid var(--line); border-radius:8px; }
  table { border-collapse:collapse; width:100%; font-size:.85rem; }
  th, td { text-align:left; padding:.5rem .65rem; border-bottom:1px solid var(--line); vertical-align:top; white-space:nowrap; }
  td.wrapcell { white-space:normal; min-width:16rem; }
  th { position:sticky; top:0; background:var(--bg); font-weight:600; font-size:.75rem; text-transform:uppercase; letter-spacing:.03em; color:var(--muted); }
  tr:target { outline:2px solid var(--accent); }
  a { color:var(--accent); }
  .tag { display:inline-block; padding:.05rem .4rem; border:1px solid var(--line); border-radius:99px; font-size:.72rem; color:var(--muted); }
  .in_force { color:#137a3f; } .planned { color:#8a5a00; } .postponed { color:#a33; } .cancelled { color:var(--muted); text-decoration:line-through; }
  footer { margin-top:2rem; color:var(--muted); font-size:.8rem; }
  .permalink { color:var(--muted); text-decoration:none; }
</style>
</head>
<body>
<main>
  <h1>E-invoicing mandates</h1>
  <p class="meta">
    Release <strong>{{.Release.Release}}</strong> &middot; schema v{{.Release.SchemaVersion}} &middot;
    generated {{.Release.GeneratedOn}} &middot;
    {{.Release.Counts.Countries}} countries, {{.Release.Counts.Mandates}} mandates,
    {{.Release.Counts.Phases}} phases, {{.Release.Counts.Sources}} cited sources.
  </p>

  <div class="controls">
    <input id="q" type="search" placeholder="Filter country, format, network…" aria-label="Filter">
    <select id="region" aria-label="Region">
      <option value="">All regions</option>
      {{range .Regions}}<option value="{{.}}">{{.}}</option>{{end}}
    </select>
    <select id="phase" aria-label="Phase status">
      <option value="">All phase states</option>
      <option value="in_force">In force</option>
      <option value="planned">Planned</option>
      <option value="postponed">Postponed</option>
      <option value="cancelled">Cancelled</option>
    </select>
  </div>

  <div class="wrap">
  <table id="t">
    <thead>
      <tr>
        <th>Country</th><th>Mandate</th><th>Scope</th><th>Model</th><th>Network</th>
        <th>Formats</th><th>From</th><th>Obligation</th><th>Applies to</th>
        <th>Threshold</th><th>Phase</th><th>Source</th>
      </tr>
    </thead>
    <tbody>
    {{range .Rows}}
      <tr id="{{.Anchor}}" data-region="{{.Region}}" data-phase="{{.PhaseStatus}}"
          data-text="{{.Country}} {{.CountryName}} {{.MandateTitle}} {{.Network}} {{.Formats}} {{.AppliesTo}} {{.Scope}}">
        <td><a class="permalink" href="#{{.Anchor}}" title="Permalink">{{.Country}}</a> {{.CountryName}}</td>
        <td class="wrapcell">{{.MandateTitle}}</td>
        <td><span class="tag">{{.Scope}}</span></td>
        <td>{{.Model}}</td>
        <td>{{if .Network}}{{.Network}}{{else}}&mdash;{{end}}</td>
        <td>{{.Formats}}</td>
        <td>{{.StartsOn}}{{if .Postponed}} <span class="tag" title="This date has moved at least once">moved</span>{{end}}</td>
        <td>{{.Obligation}}</td>
        <td class="wrapcell">{{.AppliesTo}}</td>
        <td>{{if .Threshold}}{{.Threshold}}{{else}}&mdash;{{end}}</td>
        <td class="{{.PhaseStatus}}">{{.PhaseStatus}}</td>
        <td>{{if .SourceURL}}<a href="{{.SourceURL}}" rel="noopener noreferrer nofollow">official</a>
            <span class="tag">{{.VerifiedOn}}</span>{{else}}&mdash;{{end}}</td>
      </tr>
    {{end}}
    </tbody>
  </table>
  </div>

  <footer>
    Every row cites an official source and the date a human last checked it.
    Generated by <code>einvoice-mandates render</code>. Not legal advice.
  </footer>
</main>
<script>
(function () {
  var q = document.getElementById('q'),
      region = document.getElementById('region'),
      phase = document.getElementById('phase'),
      rows = Array.prototype.slice.call(document.querySelectorAll('#t tbody tr'));
  function apply() {
    var term = q.value.trim().toLowerCase(), r = region.value, p = phase.value;
    rows.forEach(function (row) {
      var ok = (!term || row.dataset.text.toLowerCase().indexOf(term) !== -1) &&
               (!r || row.dataset.region === r) &&
               (!p || row.dataset.phase === p);
      row.style.display = ok ? '' : 'none';
    });
  }
  [q, region, phase].forEach(function (el) { el.addEventListener('input', apply); });
})();
</script>
</body>
</html>
